* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.toml text eol=lf
*.kit text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.usdc binary
*.npz binary
*.zip binary
*.png binary
assets/scene/**/*.usdc filter=lfs diff=lfs merge=lfs -text
assets/scenarios/fields/*.npz filter=lfs diff=lfs merge=lfs -text
assets/downloads/*.zip filter=lfs diff=lfs merge=lfs -text
assets/ui/**/*.png filter=lfs diff=lfs merge=lfs -text
