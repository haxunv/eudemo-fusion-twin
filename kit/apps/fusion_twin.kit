[package]
title = "EU DEMO Fusion Twin"
version = "0.1.0"
description = "Native NVIDIA RTX viewport for the EU DEMO engineering demonstrator."

[dependencies]
"omni.kit.uiapp" = {}
"omni.hydra.rtx" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.viewport.scene_camera_model" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.raycast.query" = {}
"omni.kit.renderer.capture" = {}
"omni.kit.livestream.app" = { version = "10.2.0", exact = true }
"omni.kit.livestream.messaging" = { version = "1.3.1", exact = true }
"fusion.twin.schema" = {}
"omni.rtwt.controller" = {}
"omni.rtwt.inference" = {}
"omni.cae.index" = {}
"fusion.twin.bridge" = {}

[settings.app]
window.title = "EU DEMO Fusion Twin · NVIDIA RTX"
window.width = 2560
window.height = 1440
window.hideUi = true
renderer.resolution.width = 2560
renderer.resolution.height = 1440
renderer.skipWhileMinimized = false
renderer.sleepMsOutOfFocus = 0
viewport.defaults.fillViewport = true
viewport.defaults.noTitleBar = true
viewport.grid.enabled = false
viewport.forceHideFps = true
settings.persistent = false
file.ignoreUnsavedOnExit = true
fastShutdown = true
vsync = false

[settings]
exts."omni.rtwt.controller".workflow_manifest = "${app}/../workflow/workflow.toml"
exts."omni.rtwt.controller".app_state_api_schemas = ["FusionTwinAppStateAPI"]
exts."omni.rtwt.controller".disable_viewport_selection = false
exts."omni.rtwt.inference".offline_mode = true
exts."omni.rtwt.inference".generate_if_missing = false
exts."omni.rtwt.inference".offline_cache_dir = "${app}/../../runtime/nvidia/offline"
rtx.index.compositeEnabled = true
rtx.index.compositeDepthMode = 3
rtx.index.overrideSubdivisionMode = "kd_tree"
rtx.index.overrideSubdivisionPartCount = 1
persistent.rtx.modes.rt2.enabled = true
# Kept equal to the output size: each viewport resize rebuilds the RTX Hydra engine,
# and repeated rebuilds deadlocked Kit 110.1.3 in UsdContext scheduling.
fusion.render.interactiveWidth = 2560
fusion.render.interactiveHeight = 1440
fusion.render.settleSeconds = 0.75
rtx.rendermode = "RealTimePathTracing"
rtx-transient.dlssg.enabled = false
rtx.ecoMode.enabled = false
rtx.background.source.type = 2
rtx.background.source.color = [0.012, 0.018, 0.026]
renderer.multiGpu.enabled = false
app.runLoops.main.rateLimitEnabled = true
app.runLoops.main.rateLimitFrequency = 30
app.runLoops.present.rateLimitEnabled = true
app.runLoops.present.rateLimitFrequency = 30
app.runLoops.rendering_0.rateLimitEnabled = true
app.runLoops.rendering_0.rateLimitFrequency = 30
app.viewport.defaults.tickRate = 30
app.rendergraph.maxFramesInFlight = 2
exts."omni.kit.viewport.window".startup.windowName = "Viewport"
exts."omni.kit.viewport.window".startup.dockTabInvisible = true
exts."omni.kit.viewport.window".bindings.camera.PanGesture = "Any MiddleButton"
exts."omni.kit.viewport.window".bindings.camera.TumbleGesture = "Any LeftButton"
exts."omni.kit.viewport.window".bindings.camera.ZoomGesture = "Alt RightButton"
exts."omni.kit.viewport.window".bindings.camera.ZoomScrollGesture = "Any"

[settings.exts."omni.kit.livestream.app".primaryStream]
allowDynamicResize = false
enableEventTracing = false
enableAudioCapture = false
signalPort = 49100
streamPort = 47998
targetFps = 30
publicIp = "127.0.0.1"

[settings.app.exts]
folders.'++' = [
    "${app}/../extensions",
]
