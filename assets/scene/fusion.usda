    def Xform "Machine" (
        kind = "assembly"
        variants = {
            string design = "conventional"
        }
        prepend variantSets = "design"
    )
    {
        variantSet "design" = {
            "conventional" {
                def Xform "tf_coils" (
                    customData = {
                        string componentId = "tf_coils"
