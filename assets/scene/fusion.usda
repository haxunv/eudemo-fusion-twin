#usda 1.0
(
    customLayerData = {
        string copyright = "See source/provenance.json"
        string dataStatus = "conceptual_design_and_simulation"
        string defaultCamera = "/World/Cameras/overview"
    }
    defaultPrim = "World"
    doc = "EU-DEMO-like conceptual CAD assembly. Original B-rep retained in assets/source. Render units: metres."
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "steel" (
            customData = {
                double textureRepeatMeters = 0.0625
            }
        )
        {
            token outputs:mdl:surface.connect = </World/Looks/steel/MDL.outputs:out>
            token outputs:surface.connect = </World/Looks/steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.53, 0.6, 0.66)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.25
                token outputs:surface
            }

            def Shader "MDL"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./materials/FusionPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "FusionPBR"
                color3f inputs:base_color = (0.53, 0.6, 0.66)
                float inputs:metallic = 0.9
                asset inputs:normal_map = @./materials/brushed_normal.png@
                float inputs:normal_strength = 0.12
                float inputs:repeat_per_meter = 16
                float inputs:roughness = 0.25
                token outputs:out
            }
        }

