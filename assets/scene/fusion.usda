    def Xform "Machine" (
        kind = "assembly"
        variants = {
            string design = "conventional"
        }
        prepend variantSets = "design"
    )
    {
        variantSet "design" = {
            "conventional" {
                def Xform "tf_coils" (
                    customData = {
                        string componentId = "tf_coils"
                        string nameZh = "环向场线圈"
                        string source = "Bluemira EU-DEMO-like"
                    }
                    displayName = "Toroidal field coils"
                )
                {
                    def Xform "sector_00" (
                        customData = {
                            bool sectionHidden = 0
                            int sectorIndex = 0
                        }
                        prepend references = @./geometry/conventional/tf_coils.usdc@
                    )
                    {
                        float xformOp:rotateZ = 0
                        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
                    }

                    def Xform "sector_01" (
                        customData = {
                            bool sectionHidden = 0
                            int sectorIndex = 1
                        }
                        prepend references = @./geometry/conventional/tf_coils.usdc@
                    )
                    {
                        float xformOp:rotateZ = 20
                        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
                    }

                    def Xform "sector_02" (
                        customData = {
                            bool sectionHidden = 0
                            int sectorIndex = 2
                        }
                        prepend references = @./geometry/conventional/tf_coils.usdc@
                    )
                    {
                        float xformOp:rotateZ = 40
                        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
                    }

                    def Xform "sector_03" (
                        customData = {
                            bool sectionHidden = 0
                            int sectorIndex = 3
                        }
                        prepend references = @./geometry/conventional/tf_coils.usdc@
                    )
                    {
                        float xformOp:rotateZ = 60
                        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
                    }

                    def Xform "sector_04" (
                        customData = {
                            bool sectionHidden = 0
                            int sectorIndex = 4
                        }
                        prepend references = @./geometry/conventional/tf_coils.usdc@
                    )
                    {
                        float xformOp:rotateZ = 80
